# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- PostHog product analytics (spec 2026-08-02-08) ---------------------------
# Entirely inert unless SP_POSTHOG_PROJECT_API_KEY is set.

# Client key (phc_...). Public by design — it ships to every browser.
# PostHog: Settings -> Project -> Project API key
SP_POSTHOG_PROJECT_API_KEY=

# API host. EU cloud is the default; override for US cloud, self-hosted,
# or a reverse proxy.
SP_POSTHOG_HOST=https://eu.i.posthog.com

# Optional, SECRET. Only needed if backend capture should use a distinct key;
# otherwise the project key is used. PostHog shows this once at creation and
# never again — for anything beyond local dev, keep it in Passbolt / SSM /
# the OS keyring rather than on disk.
# PostHog: Settings -> Personal API keys -> Create personal API key
SP_POSTHOG_PERSONAL_API_KEY=

# Kill switch. Defaults to true; setting false disables analytics even when a
# key is present. It does not enable anything on its own.
SP_POSTHOG_ENABLED=true

# --- Telegram alerts (spec 2026-08-10-04) ------------------------------------
# SP_TELEGRAM_BOT_TOKEN ALONE IS SUFFICIENT. Everything else below is an
# optional override: the server derives the bot @username from getMe on its
# first boot, generates a webhook secret, and persists both as system
# parameters (telegram.bot_username, telegram.webhook_secret) so later boots
# make no network call.
#
# A Telegram bot can hold exactly ONE webhook URL, so dev and prod each need
# their own bot from @BotFather. Real values belong in
# telegram_bot_solidping_{dev,prod}.priv.json (gitignored) or your secret
# store — never here.

# SECRET, and the ONLY required variable. `123456789:AA…` from @BotFather
# (/newbot, or /token for an existing bot). Never logged, never returned by
# any API.
SP_TELEGRAM_BOT_TOKEN=

# Tri-state kill switch. LEAVE IT COMMENTED OUT — unset means auto: on iff a
# bot token is present, which is what you want. Set it to false to force the
# feature off whatever else is configured, or true to be explicit (it still
# needs a token). A bare `SP_TELEGRAM_ENABLED=` is treated as unset, not false.
#SP_TELEGRAM_ENABLED=

# OPTIONAL override. The bot's @username without the '@'. Derived from getMe
# and persisted on first boot; set it only to skip that call, or when running
# declarative/GitOps config.
SP_TELEGRAM_BOT_USERNAME=

# OPTIONAL override. SECRET, >= 32 random bytes (`openssl rand -hex 32`).
# Generated and persisted automatically when unset. Telegram does not sign its
# webhook payloads, so this shared secret is the ONLY authenticity gate on a
# public endpoint that creates paging contacts — set it by hand only when
# something else must know it too (e.g. a proxy in front of the webhook).
SP_TELEGRAM_WEBHOOK_SECRET=

# Overrides https://api.telegram.org. For an egress proxy or a test fake.
SP_TELEGRAM_BASE_URL=

# Per-org hourly runaway guard (default 60). Telegram messages are free, so
# there is deliberately no monthly quota — this only bounds a flapping check
# or a broken dispatch loop.
SP_ENTITLEMENTS_TELEGRAM_RUNAWAY_PER_HOUR=

# ---------------------------------------------------------------------------
# Frontend dev server (web/dash0)
# ---------------------------------------------------------------------------

# Extra hostnames the Vite dev server will answer for, comma-separated. Only
# needed when you reach `make dev` through a tunnel or a remote hostname rather
# than localhost — Vite rejects unknown Host headers otherwise. Empty = only
# localhost, which is what most people want.
#   VITE_DEV_ALLOWED_HOSTS=app.dev.example.com
VITE_DEV_ALLOWED_HOSTS=
