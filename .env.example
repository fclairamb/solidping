# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- PostHog product analytics (spec 2026-08-02-08) ---------------------------
# Entirely inert unless SP_POSTHOG_PROJECT_API_KEY is set.

# Client key (phc_...). Public by design — it ships to every browser.
# PostHog: Settings -> Project -> Project API key
SP_POSTHOG_PROJECT_API_KEY=

# API host. EU cloud is the default; override for US cloud, self-hosted,
# or a reverse proxy.
SP_POSTHOG_HOST=https://eu.i.posthog.com

# Optional, SECRET. Only needed if backend capture should use a distinct key;
# otherwise the project key is used. PostHog shows this once at creation and
# never again — for anything beyond local dev, keep it in Passbolt / SSM /
# the OS keyring rather than on disk.
# PostHog: Settings -> Personal API keys -> Create personal API key
SP_POSTHOG_PERSONAL_API_KEY=

# Kill switch. Defaults to true; setting false disables analytics even when a
# key is present. It does not enable anything on its own.
SP_POSTHOG_ENABLED=true
