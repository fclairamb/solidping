{
  "id": 101,
  "name": "Acme signup flow",
  "active": true,
  "interval": 10,
  "region": "us-west",
  "type": "script",
  "tags": ["tms", "signup"],
  "send_notification_when_down": 2,
  "steps": [
    {"fn": "basic_auth", "args": {"username": "stagingUser", "password": "s3cr3t-pw"}},
    {"fn": "go_to", "args": {"url": "acme.example/start"}},
    {"fn": "click", "args": {"element": "START FREE TRIAL"}},
    {"fn": "fill", "args": {"input": "Email", "value": "a\"b@acme.example"}},
    {"fn": "check", "args": {"checkbox": "terms"}},
    {"fn": "uncheck", "args": {"checkbox": "newsletter"}},
    {"fn": "select_radio", "args": {"radio": "plan"}},
    {"fn": "select", "args": {"select": "country", "option": "France"}},
    {"fn": "submit", "args": {"form": "signup"}},
    {"fn": "sleep", "args": {"seconds": "0.5"}},
    {"fn": "wait_for_element", "args": {"element": "#welcome"}},
    {"fn": "wait_for_contains", "args": {"element": "#welcome", "value": "Welcome"}},
    {"fn": "url", "args": {"url": "https://acme.example/welcome/"}},
    {"fn": "exists", "args": {"element": "#welcome"}},
    {"fn": "not_exists", "args": {"element": "#error"}},
    {"fn": "contains", "args": {"element": "body", "value": "Thanks"}},
    {"fn": "not_contains", "args": {"element": "body", "value": "Oops"}},
    {"fn": "field_contains", "args": {"input": "Email", "value": "acme"}},
    {"fn": "field_not_contains", "args": {"input": "Email", "value": "nope"}},
    {"fn": "is_checked", "args": {"checkbox": "terms"}},
    {"fn": "is_not_checked", "args": {"checkbox": "newsletter"}},
    {"fn": "radio_selected", "args": {"radio": "plan"}},
    {"fn": "dropdown_selected", "args": {"select": "country", "option": "France"}},
    {"fn": "dropdown_not_selected", "args": {"select": "country", "option": "Spain"}}
  ]
}
