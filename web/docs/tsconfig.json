{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    // @docusaurus/tsconfig still sets baseUrl, which TypeScript 6 reports as a
    // hard error (TS5101). Silence it here rather than fighting the preset.
    "ignoreDeprecations": "6.0"
  },
  // src/**/*.test.ts runs under `bun test` (see the test:unit script) and relies
  // on bun's ambient globals, which this project's libs do not carry.
  "exclude": [".docusaurus", "build", "src/**/*.test.ts"]
}
