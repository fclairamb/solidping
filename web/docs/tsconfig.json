{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": "."
  },
  // src/**/*.test.ts runs under `bun test` (see the test:unit script) and relies
  // on bun's ambient globals, which this project's libs do not carry.
  "exclude": [".docusaurus", "build", "src/**/*.test.ts"]
}
