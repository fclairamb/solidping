# Bench image: the CURRENT working tree, compiled for Linux and packaged in the
# production base image, so `make bench-memory BENCH_MEM_MODE=docker` can measure
# a *modified* build and not just a released tag.
#
# Why it is not the main Dockerfile: that one rebuilds dash0, status0 and the
# whole Docusaurus site from source (minutes, and a build context that includes
# every node_modules). This one takes the embedded assets already present in the
# working tree — `server/internal/app/{res,dash0res,status0res,docsres}`,
# produced by `make build` — and only recompiles Go. Same embedded bytes, same
# base image, a fraction of the time.
#
# Consequence worth knowing before quoting a number from it: the embedded assets
# are whatever `make build` last put in the tree. If they are stale, the binary's
# rodata is stale too — which moves rssFile/Pss, not the anon numbers the primary
# metric is made of.
#
# Build context is `server/` (the Go module root), which is what keeps
# node_modules out of it:
#
#   docker build -f Dockerfile.bench -t solidping-bench:local server/

# NOTE the divergence: the shipped Dockerfile is on golang:1.27.1-trixie. This
# pin is deliberately one patch behind because the committed baseline
# (wiki/runbooks/memory-baselines/2026-09-04-docker-arm64.json) records
# goVersion go1.27.0 — bumping the toolchain under a baseline measured on the
# old one would make the two disagree silently. Bump this line and re-baseline
# in the same change.
FROM golang:1.27.1-trixie AS build

WORKDIR /src

# Dependencies first so a source-only change reuses the module cache.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO on, matching the shipped Dockerfile.
#
# Note what that does NOT mean, because this file used to claim the opposite:
# cgo does not select the mattn SQLite driver. The build tags in
# internal/db/sqlitedriver (copied verbatim from the sqliteshim they replaced)
# select the pure-Go **modernc** driver on every platform we ship to unless
# `-tags cgosqlite` is passed, so SQLite allocations here are ON the Go heap and
# visible to pprof. See wiki/runbooks/memory-profiling.md section 4.
#
# CGO_ENABLED=1 still matters for the measurement: it changes the linker mode
# (dynamic against the base image's glibc rather than a static binary), which
# moves the file-backed mappings and the thread/stack accounting this bench
# reports. Building with CGO_ENABLED=0 would measure a differently-shaped
# process from the one we ship — just not a differently-driven one.
RUN CGO_ENABLED=1 go build -o /solidping .

# Same base as the production image, so the runtime's libc, page size and
# file-backed mappings match.
FROM gcr.io/distroless/base-debian13:nonroot

WORKDIR /app

COPY --from=build /solidping /app/solidping

EXPOSE 4000

ENTRYPOINT ["/app/solidping", "serve"]
