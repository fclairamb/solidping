# systemd unit shipped by the solidping-bin AUR package. It mirrors the unit
# `solidping service install` writes (server/cmd_service_systemd.go), with the
# paths fixed by the package: the binary in /usr/bin, the data in
# /var/lib/solidping (created by StateDirectory=), the account from
# solidping.sysusers. Don't also run `solidping service install`: it would
# write a second unit in /etc/systemd/system that shadows this one.
[Unit]
Description=SolidPing monitoring
Documentation=https://solidping.io/docs/installation/linux
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
# SP_* variables, each overriding the matching config.yml key (SP_DB_URL is
# db.url). Optional: the leading "-" lets the service start without it.
EnvironmentFile=-/var/lib/solidping/config.env
ExecStart=/usr/bin/solidping serve
WorkingDirectory=/var/lib/solidping
StateDirectory=solidping
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
User=solidping
Group=solidping
Environment=HOME=/var/lib/solidping
UMask=0077
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/solidping

[Install]
WantedBy=multi-user.target
