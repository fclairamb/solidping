# Binary
solidping
bin/

# Private stuff
*.local*
*.priv*
# ...but the Private-locations dashboard page (and its register-agent wizard
# sub-route) is source code, not a key.
!*.private-locations.tsx
!*.private-locations.register.tsx

# Environment files. These routinely hold live credentials (SP_POSTHOG_*,
# SP_ENCRYPTION_MASTER_KEY, OAuth client secrets…), so they must never be
# committable — not even by an accidental `git add -A`. `.env.example` is
# deliberately left trackable: it is the credential-free template, so it can be
# committed if someone chooses to.
.env
.env.*
!.env.example

# Frontend builds
server/internal/app/dash0res/
server/internal/app/status0res/
server/internal/app/docsres/

# Test data
test-results/
playwright-report/

# Showcase media pipeline scratch: raw Playwright .webm recordings, traces and
# untrimmed stills. Only the post-processed assets under
# web/docs/static/showcase/ are committed. See web/dash0/showcase/README.md.
web/dash0/showcase/output/

# Bench artefacts (loadgen + bench-checks)
bench-data/
bench-results/

# Runtime file storage created by the server on startup
/data/
/server/data/

# Resources
server/internal/app/res/

# Various garbage
.DS_Store
*.db
*.db-journal
logs/
agent-keys.json

# Claude Code
.claude/scheduled_tasks.lock
.claude/worktrees/
